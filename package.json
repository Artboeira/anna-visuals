{
  "name": "anna-led-visuals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"wait-on tcp:5178 && electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build && electron-builder",
    "build:mac": "tsc -b && vite build && electron-builder --mac --x64 --arm64",
    "rebuild:ndi": "cd electron/native && node-gyp rebuild",
    "rebuild:spout": "cd electron/native-spout && node-gyp rebuild",
    "preview": "vite preview"
  },
  "dependencies": {
    "chroma-js": "^2.4.2",
    "file-saver": "^2.0.5",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "optionalDependencies": {
    "node-syphon": "^1.5.0"
  },
  "devDependencies": {
    "@types/chroma-js": "^2.4.4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "bindings": "^1.5.0",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "node-addon-api": "^7.1.1",
    "node-gyp": "^11.2.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.estudio-ab.anna-led",
    "productName": "ANNA LED Visuals",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/native/build/**/Release/obj.target/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
